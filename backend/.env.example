PORT=5000
JWT_SECRET=

# Set to "mongodb" or "supabase" to pick which database to use
DB_PROVIDER=mongodb

# Used when DB_PROVIDER=mongodb
MONGODB_URI=mongodb://127.0.0.1:27017/easycart

# Used when DB_PROVIDER=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Passcode needed to create a platform admin at /admin/register. Leave empty to disable admin sign-up.
ADMIN_SIGNUP_PASSCODE=

# --- Production (set these on your hosting platform; the server refuses to start in production without the required ones) ---

# "production" turns on the startup safety check, rate limits behind a proxy, and generic error messages
NODE_ENV=development

# REQUIRED in production. At least 32 random characters, for example from: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# (the JWT_SECRET line above)

# REQUIRED in production. Website address(es) allowed to call this API, comma separated, no trailing slash
# Example: CORS_ORIGIN=https://shop.example.com,https://admin.example.com
# Use * to allow every website (fine for a quick test, tighten it before real users)
CORS_ORIGIN=

# How many proxies sit in front of the server. Most hosting platforms use 1 (this is the default in production)
TRUST_PROXY=
