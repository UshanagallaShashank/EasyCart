# Address of the EasyCart backend (the same one the website uses; it talks to Supabase).
# On a phone, use your computer's LAN address, e.g. http://192.168.1.20:5000 — "localhost" means the phone itself.
EXPO_PUBLIC_API_URL=http://localhost:5000
# Shop opened by default on the customer home screen (the sample data creates this one).
EXPO_PUBLIC_DEFAULT_STORE=green-leaf-market

# Outside logs for the phone app (optional): a SECOND Better Stack "Logs" source, separate from the backend's.
EXPO_PUBLIC_LOG_INGEST_URL=
EXPO_PUBLIC_LOG_INGEST_TOKEN=
# Keep a copy of the data in an on-phone SQLite database, so screens open instantly and work offline. Off for now.
EXPO_PUBLIC_OFFLINE_CACHE=false
